# Copy to .env and fill in. Never commit the real .env file.

# Required: the bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=your-bot-token-here

# Optional settings (defaults shown). Relative paths are relative to the
# working directory; point DB_PATH at a persistent volume in production.
# DB_PATH=data/leaderboard.db
# FLUSH_INTERVAL_SECONDS=5
# RESET_GRACE_SECONDS=120
# BOARD_UPDATE_SECONDS=300
# LOG_DIR=logs
# LOG_LEVEL=INFO
# Roles allowed to use the bot's commands (all except /stats); the server owner always can.
# Defaults to the three staff roles below. Comma-separated role IDs, or "off" for no role gate.
# STAFF_ROLE_IDS=1343413837101011047,1343265536141688964,1534411578378682519
