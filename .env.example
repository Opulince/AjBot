# Copy to .env and fill in. Never commit the real .env file.

# Required: the bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=your-bot-token-here

# Optional settings (defaults shown). Relative paths are relative to the
# working directory; point DB_PATH at a persistent volume in production.
# DB_PATH=data/leaderboard.db
# FLUSH_INTERVAL_SECONDS=5
# RESET_GRACE_SECONDS=120
# BOARD_UPDATE_SECONDS=300
# LOG_DIR=logs
# LOG_LEVEL=INFO
